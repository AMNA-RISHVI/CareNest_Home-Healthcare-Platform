

const dateButtons = document.querySelectorAll('.date-btn');
const timeButtons = document.querySelectorAll('.time-btn');

const selectedDate = document.getElementById('selected_date');
const selectedTime = document.getElementById('selected_time');


// Select Date
dateButtons.forEach(button => {

    button.addEventListener('click', function () {

        dateButtons.forEach(btn => {
            btn.classList.remove('active');
        });

        this.classList.add('active');

        selectedDate.value = this.dataset.date;

        // Show only times for selected date
        timeButtons.forEach(timeButton => {

            if (timeButton.dataset.date === selectedDate.value) {
                timeButton.style.display = 'block';
            } else {
                timeButton.style.display = 'none';
            }

        });

        // Clear previously selected time
        selectedTime.value = '';

        timeButtons.forEach(btn => {
            btn.classList.remove('active');
        });

    });

});


// Select Time
timeButtons.forEach(button => {

    button.addEventListener('click', function () {

        timeButtons.forEach(btn => {
            btn.classList.remove('active');
        });

        this.classList.add('active');

        selectedTime.value = this.dataset.time;

    });

});


// Initially hide all times
timeButtons.forEach(button => {
    button.style.display = 'none';
});

